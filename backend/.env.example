# Server Environment & CORS Configuration
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# AI Model Engine Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Optional Cloud LLM Fallback (if Ollama is not hosted on CPU):
GROQ_API_KEY=your_groq_api_key_placeholder

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql+psycopg2://postgres_user:postgres_password@localhost:5432/sentinelforge_db
# Or for local SQLite:
# DATABASE_URL=sqlite:///./sentinelforge.db

# RAG Pipeline Settings
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_DIR=rag_storage/chroma
COLLECTION_NAME=cybersecurity_knowledge
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35
